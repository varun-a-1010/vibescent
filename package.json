{
  "name": "vibescent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build",
    "probe:brief": "node scripts/with-keys.mjs tsx scripts/probe-brief.ts",
    "probe": "node scripts/with-keys.mjs tsx scripts/probe-tags.ts"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "fastify": "^5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
