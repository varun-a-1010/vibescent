{
  "name": "vibescent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build",
    "probe:brief": "node scripts/with-keys.mjs tsx scripts/probe-brief.ts",
    "probe": "node scripts/with-keys.mjs tsx scripts/probe-tags.ts",
    "dev": "node scripts/with-keys.mjs concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "start": "NODE_ENV=production node scripts/with-keys.mjs tsx server/index.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@google/genai": "2.30.0",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
